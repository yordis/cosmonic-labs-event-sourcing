package cosmonic:eventsourcing@0.0.1;

/// Transaction Command Interface
interface transaction-command {
    /// Command type specific to transactions
    resource command;
    
    /// Serialize the transaction command to its byte representation.
    serialize-command: func(command: command) -> result<list<u8>, string>;
    
    /// Deserialize the transaction command from its byte representation.
    deserialize-command: func(command: list<u8>) -> result<command, string>;
}

/// Transaction State Interface
interface transaction-state {
    /// State type specific to transactions
    resource state;
    
    /// Serialize the aggregate state to its byte representation.
    serialize-state: func(state: state) -> result<list<u8>, string>;
    
    /// Deserialize the aggregate state from its byte representation.
    deserialize-state: func(state: list<u8>) -> result<state, string>;
}

/// Transaction Evolve Interface
interface transaction-evolve {
    use cosmonic:eventsourcing/shared-types.{event};
    use transaction-state.{state};
    
    /// Errors that can occur when evolving transaction state
    variant evolve-error {
        invalid-event,
        inconsistent-state,
        unknown-event-type,
        state-corruption,
    }
    
    /// Evolve the state by applying a single event.
    evolve: func(state: state, event: event) -> result<state, evolve-error>;
}

/// Transaction Decide Interface
interface transaction-decide {
    use cosmonic:eventsourcing/shared-types.{event};
    use transaction-command.{command};
    use transaction-state.{state};
    
    /// Errors that can occur when deciding on transaction commands
    variant decide-error {
        insufficient-funds(string),
        account-not-found,
        account-closed,
        invalid-amount,
        negative-balance-not-allowed,
        transaction-limit-exceeded(u64),
    }
    
    /// Decide what events to produce based on current state and command
    decide: func(state: state, command: command) -> result<list<event>, decide-error>;
}

/// Transaction Command Handler
interface transaction {
    use cosmonic:eventsourcing/shared-types.{event};
    use transaction-command.{command};
    use transaction-state.{state};
    use transaction-decide.{decide-error};
    use transaction-evolve.{evolve-error};
    
    /// Command handling option
    record command-option {
        expected-revision: option<u64>,
    }
    
    /// Result of handling a transaction command
    record command-result {
        next-expected-version: u64,
        events: list<event>,
        state: state,
    }
    
    /// Errors that can occur when handling transaction commands
    variant handle-command-error {
        decide(decide-error),
        evolve(evolve-error),
        wrong-expected-version,
        unknown,
    }
    
    /// Extract the stream ID from the transaction command
    stream-id: func(command: command) -> string;
    
    /// Handle the transaction command
    handle-command: func(command: command, option: option<command-option>) -> result<command-result, handle-command-error>;
}

/// World specifically for handling transaction commands
world transaction-w {
    import cosmonic:eventsourcing/shared-types;
    export transaction-command;
    export transaction-state;
    export transaction-evolve;
    export transaction-decide;
    export transaction;
} 