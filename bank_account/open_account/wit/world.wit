package cosmonic:eventsourcing@0.0.1;

/// Open Account Command Interface
interface open-account-command {
    /// Command type specific to opening accounts
    resource command;
    
    /// Serialize the open-account command to its byte representation.
    serialize-command: func(command: command) -> result<list<u8>, string>;
    
    /// Deserialize the open-account command from its byte representation.
    deserialize-command: func(command: list<u8>) -> result<command, string>;
}

/// Open Account State Interface
interface open-account-state {
    use cosmonic:eventsourcing/shared-types.{event};
    
    /// State type specific to opening accounts
    resource state;
    
    /// Serialize the aggregate state to its byte representation.
    serialize-state: func(state: state) -> result<list<u8>, string>;
    
    /// Deserialize the aggregate state from its byte representation.
    deserialize-state: func(state: list<u8>) -> result<state, string>;
    
    /// Evolve the state by applying a single event.
    evolve: func(state: state, event: event) -> state;
}

/// Open Account Command Handler
interface open-account {
    use cosmonic:eventsourcing/shared-types.{event};
    use open-account-command.{command};
    use open-account-state.{state};
    
    /// Command handling option
    record command-option {
        expected-revision: option<u64>,
    }
    
    /// Result of handling an open account command
    record command-result {
        next-expected-version: u64,
        events: list<event>,
        state: state,
    }
    
    /// Errors that can occur when deciding on open account commands
    variant decide-error {
        account-already-exists,
        invalid-account-number(string),
        invalid-initial-balance,
        missing-customer-info,
        regulatory-restriction(string),
        minimum-balance-not-met(u64),
    }
    
    /// Errors that can occur when handling open account commands
    variant handle-command-error {
        decide(decide-error),
        wrong-expected-version,
        unknown,
    }
    
    /// Decide what events to produce based on current state and command
    decide: func(state: state, command: command) -> result<list<event>, decide-error>;
    
    /// Handle the open account command
    handle-command: func(command: command, option: command-option) -> result<command-result, handle-command-error>;
}

/// World specifically for handling open account commands  
world open-account-w {
    import cosmonic:eventsourcing/shared-types;
    export open-account-command;
    export open-account-state;
    export open-account;
}