package cosmonic:eventsourcing@0.0.1;

/// Shared types and serialization functions (events and state only)
interface shared-types {
    /// Represents a state change that has occurred as a result of processing a command.
    resource event;
    /// Represents the current state of an entity, reconstructed from a sequence of events.
    resource state;
    
    /// Serialize, marshal, or encode a single event to its byte representation.
    serialize-event: func(event: event) -> result<list<u8>, string>;
    
    /// Deserialize, unmarshal, or decode a single event from its byte representation.
    deserialize-event: func(event: list<u8>) -> result<event, string>;
    
    /// Serialize, marshal, or encode the aggregate state to its byte representation.
    serialize-state: func(state: state) -> result<list<u8>, string>;
    
    /// Deserialize, unmarshal, or decode the aggregate state from its byte representation.
    deserialize-state: func(state: list<u8>) -> result<state, string>;
    
    /// Rehydrate or reconstruct this aggregate's state from a list of events.
    rehydrate: func(events: list<event>) -> result<state, string>;
}

/// Open Account Command Handler
interface open-account {
    use shared-types.{event, state};
    
    /// Command type specific to opening accounts
    resource command;
    
    /// Serialize the open-account command to its byte representation.
    serialize-command: func(command: command) -> result<list<u8>, string>;
    
    /// Deserialize the open-account command from its byte representation.
    deserialize-command: func(command: list<u8>) -> result<command, string>;
    
    /// Handle the open account command
    handle-open-account: func(state: state, command: command) -> result<list<event>, string>;
}

/// World specifically for handling open account commands
world open-account-w {
    export shared-types;
    export open-account;
}